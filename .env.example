# URL of the deployed Apps Script Web App (Deploy > New deployment > Web app)
VITE_SIDP_API_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# OAuth Client ID from Google Cloud Console, used by Google Identity Services
# for the sign-in button on the frontend.
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
